{
  "expo": {
    "name": "ChatFlow",
    "slug": "chatflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#008069"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatflow.app"
    },
    "android": {
      "package": "com.chatflow.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "chatflow"
  }
}
