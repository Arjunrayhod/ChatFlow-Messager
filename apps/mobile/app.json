{
  "expo": {
    "name": "ChatFlow",
    "slug": "chatflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121b22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatflow.app"
    },
    "android": {
      "package": "com.chatflow.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121b22"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-google-signin/google-signin",
      ["expo-notifications", { "color": "#008f72", "defaultChannel": "incoming-calls" }],
      ["@config-plugins/react-native-webrtc", {"cameraPermission": "Allow ChatFlow to use your camera for video calls.", "microphonePermission": "Allow ChatFlow to use your microphone for calls."}]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "chatflow"
  }
}
