# ==============================================================================
# ChatFlow Environment Variables
# RULE 0.1: NO PHONE NUMBERS ARE COLLECTED, STORED, OR LOGGED.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration (apps/server)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Firebase Admin SDK (Authentication verification)
FIREBASE_PROJECT_ID=chatflow-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@chatflow-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBg...==\n-----END PRIVATE KEY-----\n"

# Supabase (Postgres & Media Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (Upstash / Local for caching, socket adapter & queue)
REDIS_URL=redis://default:mock_password@localhost:6379

# ------------------------------------------------------------------------------
# Mobile Configuration (apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForDevelopmentOnly
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=chatflow-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=chatflow-dev
